# Image version to run: a tag of devzwf/partscout (see the VERSION file and CHANGELOG.md).
PARTSCOUT_VERSION=0.1.4
# Optional: run an image you built yourself with tools/build-image.sh.
# PARTSCOUT_IMAGE=partscout
# PARTSCOUT_PULL_POLICY=never
# Copy to .env (never commit it), chmod 600, then replace each value with: openssl rand -base64 32
# Master key for the key vault: losing it means re-entering your API keys. Keep it outside the data folder.
PARTSCOUT_MASTER_KEY=change-me
# Asked for once, when the password is created.
PARTSCOUT_SETUP_TOKEN=change-me
# Optional: data folder on the host, somewhere that gets backed up (owner uid 1654).
# Without this line: a named Docker volume, partscout-data.
# PARTSCOUT_DATA_PATH=/path/to/partscout/data
# Optional, HTTPS through Caddy (docker compose --profile https up -d): the name, and the folder holding fullchain.pem and
# privkey.pem, readable by PARTSCOUT_CERT_UID. Then publish the app locally only.
# PARTSCOUT_DOMAIN=partscout.example.com
# PARTSCOUT_CERT_DIR=/var/lib/partscout-certs
# PARTSCOUT_CERT_UID=1000
# PARTSCOUT_PUBLISH=127.0.0.1:5070
